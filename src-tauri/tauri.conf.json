{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Project Launcher",
  "version": "0.1.0",
  "identifier": "com.shaka.claude-project-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Project Launcher",
        "width": 900,
        "height": 700,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "focus": true,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
